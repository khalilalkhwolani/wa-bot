GEMINI_API_KEY=
GROQ_API_KEY=
# نموذج Groq للحالات الرمادية (اتركه فارغاً لاستخدام الافتراضي)
GROQ_MODEL=qwen/qwen3.8-27b
MINIMAX_API_KEY=

# Supabase staging only during testing
SUPABASE_URL=https://vwwudtzxjnhkaxujrxge.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LINK_STORAGE_BACKEND=supabase
LINK_FORWARDING_DRY_RUN=true

TARGET_LINKS_GROUP=120363406079474111@g.us
TARGET_LEADS_GROUP=120363428139488465@g.us

# طلبات الطلاب: تبدأ متوقفة. استخدم dry-run أولاً؛ لا يرسل شيئاً إلى واتساب.
# dry-run: ENABLE_STUDENT_LEADS=true + STUDENT_LEADS_MODE=dry-run + STUDENT_LEADS_SEND_ENABLED=false
# إرسال: STUDENT_LEADS_MODE=send + STUDENT_LEADS_SEND_ENABLED=true (بعد التحقق)
ENABLE_STUDENT_LEADS=false
STUDENT_LEADS_MODE=disabled
STUDENT_LEADS_SEND_ENABLED=false
STUDENT_LEADS_DEDUP_WINDOW_HOURS=12
STUDENT_LEADS_SENDER_COOLDOWN_HOURS=2

# الحسابان العاملان فقط. لا تضف account_3 قبل إعادة ربطه والتحقق منه.
BOT_SESSIONS=account_1,account_2
# لا تضغط آلاف ملفات الجلسات أثناء فتح واتساب.
SESSION_BACKUP_ON_CONNECT=false
